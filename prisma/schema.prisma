// Prisma Schema for CELRA Compliance Platform (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===================== ENUMS =====================

enum UserRole {
  owner
  hr_staff
  internal_accountant
  service_accountant
  expert
  admin
}

enum WaitingOnRole {
  owner
  hr_staff
  internal_accountant
  service_accountant
  expert
  admin
  none
}

enum Priority {
  low
  medium
  high
  urgent
}

enum MembershipStatus {
  pending
  active
  expired
}

enum EngagementStatus {
  active
  pending
  paused
}

enum ContextGroup {
  legal
  operations
  revenue_invoices
  hr_labor
  tax_accounting
  premises
  conditional_licensing
  contracts
  tech_data
}

enum ContextStatus {
  unconfirmed
  pending_reconciliation
  confirmed
  conflict
  expired
}

enum ChecklistStatus {
  not_started
  in_progress
  under_review
  need_expert
  completed
}

enum TaskStatus {
  need_info
  pending_assignee
  in_progress
  waiting_verification
  need_expert
  completed
  cancelled
}

enum PaymentStatus {
  none
  pending_auth
  held
  captured
  refunded
}

enum EvidenceStatus {
  unverified
  reconciling
  accepted
  rejected
  expired
}

enum FindingStatus {
  new
  assigned
  remediating
  waiting_recheck
  remediated
  closed
}

enum ExpertCaseStatus {
  pending_owner_approval
  pending_expert_quote
  quoted
  in_consultation
  waiting_client_supplement
  completed
  rejected
}

enum TransactionType {
  deposit
  hold
  capture
  refund
}

enum TransactionStatus {
  pending
  held
  success
  refunded
  failed
}

enum TimelineEventType {
  status_change
  comment
  upload
  verification
  escalation
  payment
}

enum LegalSourceStatus {
  valid
  needs_review
  superseded
}

// ===================== MODELS =====================

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  passwordHash         String
  name                 String
  role                 UserRole     @default(owner)
  roleTitle            String?
  avatar               String?
  phone                String?
  twoFactorSecret      String?
  isTwoFactorEnabled   Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  memberships          Membership[]
  createdOrganizations Organization[] @relation("CreatedByUser")
  taskComments         TaskComment[]
  timelineEvents       TaskTimelineEvent[]
  auditEvents          AuditEvent[]

  @@map("users")
}

model Organization {
  id                 String       @id @default(uuid())
  name               String
  taxCode            String       @unique
  legalType          String
  industry           String
  businessModel      String
  operatingYears     String
  revenueStatus      String
  employeeCount      Int          @default(1)
  locations          String?
  hasOnlineSales     Boolean      @default(false)
  address            String?
  representativeName String?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  createdBy          User?        @relation("CreatedByUser", fields: [createdById], references: [id])
  departments        Department[]
  memberships        Membership[]
  serviceEngagements ServiceEngagement[]
  contextFacts       ContextFact[]
  surveyAnswers      SurveyAnswer[]
  checklists         Checklist[]
  tasks              Task[]
  evidenceDocuments  EvidenceDocument[]
  findings           Finding[]
  expertCases        ExpertCase[]
  wallet             Wallet?
  auditEvents        AuditEvent[]

  @@map("organizations")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  leadName       String?
  memberCount    Int          @default(0)
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  tasks          Task[]
  findings       Finding[]

  @@map("departments")
}

model Membership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  departmentId   String?
  role           UserRole         @default(owner)
  roleTitle      String?
  permissions    Json?            @default("[]")
  status         MembershipStatus @default(active)
  invitedAt      DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department?      @relation(fields: [departmentId], references: [id])

  @@unique([organizationId, userId])
  @@map("memberships")
}

model ServiceEngagement {
  id             String           @id @default(uuid())
  organizationId String
  firmName       String
  leadName       String
  email          String
  phone          String
  scope          Json             @default("[]")
  outOfScope     Json             @default("[]")
  startDate      DateTime         @default(now())
  status         EngagementStatus @default(active)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("service_engagements")
}

model ContextFact {
  id              String               @id @default(uuid())
  organizationId  String
  key             String
  label           String
  group           ContextGroup
  currentValue    String
  source          String
  providedBy      String
  providedAt      DateTime             @default(now())
  status          ContextStatus        @default(unconfirmed)
  confirmedBy     String?
  affectedRules   Json?                @default("[]")
  conflictDetails String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  history         ContextFactHistory[]

  @@map("context_facts")
}

model ContextFactHistory {
  id            String      @id @default(uuid())
  contextFactId String
  value         String
  changedBy     String
  changedAt     DateTime    @default(now())
  note          String?

  contextFact   ContextFact @relation(fields: [contextFactId], references: [id], onDelete: Cascade)

  @@map("context_fact_histories")
}

model Rule {
  id                   String      @id @default(uuid())
  code                 String      @unique
  title                String
  conditionSummary     String
  conditionsJson       Json?       @default("{}")
  triggeredChecklists  Json?       @default("[]")
  version              String      @default("1.0")
  effectiveDate        DateTime    @default(now())
  legalReference       String
  priority             Priority    @default(medium)
  category             String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  checklists           Checklist[]

  @@map("rules")
}

model SurveyQuestion {
  id                 Int            @id @default(autoincrement())
  question           String
  whyCelraAsks       String
  affectedChecklists Json?          @default("[]")
  options            Json           @default("[]")
  createdAt          DateTime       @default(now())

  answers            SurveyAnswer[]

  @@map("survey_questions")
}

model SurveyAnswer {
  id             String         @id @default(uuid())
  organizationId String
  questionId     Int
  selectedOption String
  note           String?
  answeredBy     String
  answeredAt     DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  question       SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, questionId])
  @@map("survey_answers")
}

model Checklist {
  id                  String          @id @default(uuid())
  organizationId      String
  generatedFromRuleId String?
  code                String
  title               String
  category            String
  priority            Priority        @default(medium)
  status              ChecklistStatus @default(not_started)
  ruleCode            String
  contextReason       String?
  legalBasis          String?
  assigneeRole        UserRole        @default(owner)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule                Rule?           @relation(fields: [generatedFromRuleId], references: [id])
  items               ChecklistItem[]
  tasks               Task[]

  @@map("checklists")
}

model ChecklistItem {
  id               String    @id @default(uuid())
  checklistId      String
  title            String
  isRequired       Boolean   @default(true)
  isChecked        Boolean   @default(false)
  evidenceRequired Boolean   @default(false)
  note             String?

  checklist        Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

model Task {
  id                      String              @id @default(uuid())
  organizationId          String
  checklistId             String?
  code                    String
  title                   String
  category                String
  priority                Priority            @default(medium)
  departmentId            String?
  departmentName          String?
  assigneeId              String?
  assigneeName            String
  assigneeRole            UserRole            @default(owner)
  waitingOnRole           WaitingOnRole       @default(none)
  waitingOnName           String?
  reviewerId              String?
  reviewerName            String?
  reviewerRole            UserRole?
  dueDate                 DateTime
  status                  TaskStatus          @default(need_info)
  description             String
  contextTrigger          String?
  ruleCode                String
  legalBasis              String
  isPaidTask              Boolean             @default(false)
  paidTaskCost            Float?              @default(0)
  paymentStatus           PaymentStatus       @default(none)
  findingId               String?
  isSelfCertifiedNoUpload Boolean             @default(false)
  notApplicableReason     String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checklist               Checklist?          @relation(fields: [checklistId], references: [id])
  department              Department?         @relation(fields: [departmentId], references: [id])
  documents               EvidenceDocument[]
  comments                TaskComment[]
  timeline                TaskTimelineEvent[]
  expertCase              ExpertCase?

  @@map("tasks")
}

model TaskComment {
  id             String    @id @default(uuid())
  taskId         String
  authorId       String?
  authorName     String
  authorRole     UserRole  @default(owner)
  content        String
  isInternalOnly Boolean   @default(false)
  createdAt      DateTime  @default(now())

  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author         User?     @relation(fields: [authorId], references: [id])

  @@map("task_comments")
}

model TaskTimelineEvent {
  id          String            @id @default(uuid())
  taskId      String
  actorId     String?
  actorName   String
  actorRole   UserRole          @default(owner)
  type        TimelineEventType @default(status_change)
  title       String
  description String
  timestamp   DateTime          @default(now())

  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor       User?             @relation(fields: [actorId], references: [id])

  @@map("task_timeline_events")
}

model EvidenceDocument {
  id                String         @id @default(uuid())
  organizationId    String
  linkedTaskId      String?
  name              String
  category          String
  fileType          String
  fileSize          String
  filePath          String
  fileUrl           String?
  uploadedBy        String
  uploadedRole      UserRole       @default(owner)
  uploadedAt        DateTime       @default(now())
  version           String         @default("1.0")
  expiryDate        DateTime?
  status            EvidenceStatus @default(unverified)
  rejectionReason   String?
  ocrExtractedData  Json?          @default("{}")
  ocrVerified       Boolean        @default(false)
  viewPermissions   Json?          @default("[]")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task              Task?          @relation(fields: [linkedTaskId], references: [id])

  @@map("evidence_documents")
}

model Finding {
  id                      String        @id @default(uuid())
  organizationId          String
  relatedTaskId           String?
  relatedTaskCode         String?
  relatedEvidenceId       String?
  code                    String
  title                   String
  description             String
  severity                Priority      @default(medium)
  detectedBy              String
  detectedAt              DateTime      @default(now())
  responsibleDepartmentId String?
  dueDate                 DateTime
  proposedAction          String
  status                  FindingStatus @default(new)
  remediationTaskId       String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsibleDepartment   Department?   @relation(fields: [responsibleDepartmentId], references: [id])

  @@map("findings")
}

model ExpertCase {
  id                 String           @id @default(uuid())
  organizationId     String
  taskId             String           @unique
  code               String
  taskTitle          String
  reason             String
  specialtyCategory  String
  sharedDataSummary  Json?            @default("[]")
  sharedDocIds       Json?            @default("[]")
  status             ExpertCaseStatus @default(pending_owner_approval)
  quoteAmount        Float?           @default(0)
  quoteNotes         String?
  expertId           String?
  expertName         String?
  expertFeedback     String?
  clientApproved     Boolean          @default(false)
  paidAmount         Float?           @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task               Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("expert_cases")
}

model Wallet {
  id             String              @id @default(uuid())
  organizationId String              @unique
  balance        Float               @default(0)
  heldAmount     Float               @default(0)
  currency       String              @default("VND")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String            @id @default(uuid())
  walletId    String
  code        String
  taskName    String?
  requestedBy String
  amount      Float
  type        TransactionType
  status      TransactionStatus @default(pending)
  note        String?
  timestamp   DateTime          @default(now())

  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model LegalSource {
  id              String            @id @default(uuid())
  title           String
  documentNumber  String            @unique
  authority       String
  issuedDate      DateTime
  effectiveDate   DateTime
  version         String            @default("1.0")
  relevantSection String
  summary         String
  url             String?
  status          LegalSourceStatus @default(valid)
  lastReviewedAt  DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("legal_sources")
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String?
  actorId        String?
  actorName      String
  actorRole      UserRole     @default(owner)
  action         String
  entityType     String
  entityId       String
  previousValue  String?
  newValue       String?
  simulatedIp    String?
  details        String?
  timestamp      DateTime     @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?         @relation(fields: [actorId], references: [id])

  @@map("audit_events")
}
