// Prisma Schema for CELRA Compliance Platform (PostgreSQL) - Lean Tax Focus Edition

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===================== ENUMS =====================

enum UserRole {
  owner
  hr_staff
  internal_accountant
  service_accountant
  expert
  admin
}

enum WaitingOnRole {
  owner
  hr_staff
  internal_accountant
  service_accountant
  expert
  admin
  none
}

enum Priority {
  low
  medium
  high
  urgent
}

enum MembershipStatus {
  pending
  active
  expired
}

enum ContextGroup {
  legal
  operations
  revenue_invoices
  hr_labor
  tax_accounting
  premises
  conditional_licensing
  contracts
  tech_data
}

enum ContextStatus {
  unconfirmed
  pending_reconciliation
  confirmed
  conflict
  expired
}

enum TaskStatus {
  need_info
  pending_assignee
  in_progress
  waiting_verification
  need_expert
  completed
  cancelled
}

enum PaymentStatus {
  none
  pending_auth
  held
  captured
  refunded
}

enum EvidenceStatus {
  unverified
  reconciling
  accepted
  rejected
  expired
}

enum TransactionType {
  deposit
  hold
  capture
  refund
}

enum TransactionStatus {
  pending
  held
  success
  refunded
  failed
}

enum TimelineEventType {
  status_change
  comment
  upload
  verification
  escalation
  payment
}

enum StatutoryCycleType {
  MONTHLY
  QUARTERLY
  BIANNUAL_6M
  ANNUAL
  EVENT_10D
  EVENT_20D
  EVENT_45D
  EVENT_3D
  EVENT_10D_BIZ
  EVENT_30D_CAPITAL
  EVENT_90D
}

enum AuditStatus {
  pending
  running
  succeeded
  failed
}

enum ApplicableStatus {
  applicable
  not_applicable
  missing_info
  verification_required
}

enum LegalValidity {
  in_force
  expired
  unverified
}

enum ResultSource {
  rule_based
  ai_assisted
  unverified_fallback
}

enum ChecklistStatus {
  active
  paused
  archived
}

enum NotificationMilestone {
  BEFORE_7D
  BEFORE_3D
  BEFORE_1D
  DUE_TODAY
  OVERDUE
}

// ===================== MODELS =====================

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  passwordHash         String
  name                 String
  role                 UserRole     @default(owner)
  roleTitle            String?
  avatar               String?
  phone                String?
  twoFactorSecret      String?
  isTwoFactorEnabled   Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  memberships          Membership[]
  createdOrganizations Organization[] @relation("CreatedByUser")
  taskComments         TaskComment[]
  timelineEvents       TaskTimelineEvent[]
  notifications        ComplianceNotification[]
  calendarNotes        CalendarNote[]

  @@map("users")
}

model Organization {
  id                 String       @id @default(uuid())
  name               String
  taxCode            String       @unique
  legalType          String
  industry           String
  businessModel      String
  operatingYears     String
  revenueStatus      String
  employeeCount      Int          @default(1)
  locations          String?
  hasOnlineSales     Boolean      @default(false)
  address            String?
  representativeName String?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  createdBy          User?        @relation("CreatedByUser", fields: [createdById], references: [id])
  departments        Department[]
  memberships        Membership[]
  contextFacts       ContextFact[]
  tasks              Task[]
  evidenceDocuments  EvidenceDocument[]
  wallet             Wallet?
  complianceAudits   ComplianceAudit[]
  checklists         Checklist[]
  notifications      ComplianceNotification[]
  calendarNotes      CalendarNote[]

  @@map("organizations")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  leadName       String?
  memberCount    Int          @default(0)
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  tasks          Task[]

  @@map("departments")
}

model Membership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  departmentId   String?
  role           UserRole         @default(owner)
  roleTitle      String?
  permissions    Json?            @default("[]")
  status         MembershipStatus @default(active)
  invitedAt      DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department?      @relation(fields: [departmentId], references: [id])

  @@unique([organizationId, userId])
  @@map("memberships")
}

model ContextFact {
  id              String               @id @default(uuid())
  organizationId  String
  key             String
  label           String
  group           ContextGroup
  currentValue    String
  source          String
  providedBy      String
  providedAt      DateTime             @default(now())
  status          ContextStatus        @default(unconfirmed)
  confirmedBy     String?
  affectedRules   Json?                @default("[]")
  conflictDetails String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  history         ContextFactHistory[]

  @@map("context_facts")
}

model ContextFactHistory {
  id            String      @id @default(uuid())
  contextFactId String
  value         String
  changedBy     String
  changedAt     DateTime    @default(now())
  note          String?

  contextFact   ContextFact @relation(fields: [contextFactId], references: [id], onDelete: Cascade)

  @@map("context_fact_histories")
}

model Rule {
  id                   String      @id @default(uuid())
  code                 String      @unique
  title                String
  conditionSummary     String
  conditionsJson       Json?       @default("{}")
  triggeredChecklists  Json?       @default("[]")
  version              String      @default("1.0")
  effectiveDate        DateTime    @default(now())
  legalReference       String
  priority             Priority    @default(medium)
  category             String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@map("rules")
}

model ComplianceAudit {
  id                 String          @id @default(uuid())
  organizationId     String
  createdById        String?
  contextFingerprint String
  rulesVersion       String          @default("1.0")
  scope              String          @default("ALL")
  status             AuditStatus     @default(succeeded)
  summary            String?
  totalFindings      Int             @default(0)
  applicableCount    Int             @default(0)
  verifiedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  findings           AuditFinding[]

  @@index([organizationId, contextFingerprint])
  @@map("compliance_audits")
}

model AuditFinding {
  id                  String             @id @default(uuid())
  auditId             String
  organizationId      String
  factId              String?
  ruleCode            String
  obligationTitle     String
  category            String
  applicableStatus    ApplicableStatus   @default(applicable)
  actionRequired      String
  evidenceRequired    String
  legalBasis          String
  legalDocNumber      String?
  legalArticle        String?
  legalDocUrl         String?
  legalValidity       LegalValidity      @default(in_force)
  verifiedAt          DateTime?
  resultSource        ResultSource       @default(rule_based)
  cycleType           StatutoryCycleType @default(QUARTERLY)
  calculationMethod   String?
  missingDataNotice   String?
  suggestedPriority   Priority           @default(medium)
  isDismissed         Boolean            @default(false)
  acceptedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  audit               ComplianceAudit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  checklistItems      ChecklistItem[]

  @@index([organizationId, ruleCode])
  @@map("audit_findings")
}

model Checklist {
  id             String          @id @default(uuid())
  organizationId String
  createdById    String?
  code           String
  title          String
  category       String
  status         ChecklistStatus @default(active)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          ChecklistItem[]
  tasks          Task[]

  @@map("checklists")
}

model ChecklistItem {
  id                  String             @id @default(uuid())
  checklistId         String
  organizationId      String
  findingId           String?
  ruleCode            String
  title               String
  cycleType           StatutoryCycleType
  departmentId        String?
  assigneeId          String?
  assigneeName        String             @default("Người phụ trách")
  assigneeRole        UserRole           @default(owner)
  defaultPriority     Priority           @default(medium)
  legalBasis          String
  legalDocUrl         String?
  evidenceRequirement String?
  eventDate           DateTime?
  isActive            Boolean            @default(true)
  lastGeneratedPeriod String?
  nextDueDate         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  checklist           Checklist          @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  finding             AuditFinding?      @relation(fields: [findingId], references: [id], onDelete: SetNull)
  tasks               Task[]

  @@index([organizationId, cycleType])
  @@map("checklist_items")
}

model Task {
  id                      String              @id @default(uuid())
  organizationId          String
  checklistId             String?
  checklistItemId         String?
  code                    String
  title                   String
  category                String
  priority                Priority            @default(medium)
  departmentId            String?
  departmentName          String?
  assigneeId              String?
  assigneeName            String
  assigneeRole            UserRole            @default(owner)
  waitingOnRole           WaitingOnRole       @default(none)
  waitingOnName           String?
  reviewerId              String?
  reviewerName            String?
  reviewerRole            UserRole?
  dueDate                 DateTime
  status                  TaskStatus          @default(need_info)
  description             String
  contextTrigger          String?
  ruleCode                String
  periodCycle             StatutoryCycleType?
  periodKey               String?
  eventDate               DateTime?
  calculationBasisJson    Json?               @default("{}")
  legalBasis              String
  legalValidity           LegalValidity       @default(in_force)
  verifiedAt              DateTime?
  isPaidTask              Boolean             @default(false)
  isAuditPaid            Boolean             @default(false)
  paidTaskCost            Float?              @default(0)
  paymentStatus           PaymentStatus       @default(none)
  findingId               String?
  isSelfCertifiedNoUpload Boolean             @default(false)
  notApplicableReason     String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department              Department?         @relation(fields: [departmentId], references: [id])
  checklist               Checklist?          @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  checklistItem           ChecklistItem?      @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  documents               EvidenceDocument[]
  comments                TaskComment[]
  timeline                TaskTimelineEvent[]
  notifications           ComplianceNotification[]

  @@unique([organizationId, ruleCode, periodKey])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, periodCycle])
  @@map("tasks")
}

model TaskComment {
  id             String    @id @default(uuid())
  taskId         String
  authorId       String?
  authorName     String
  authorRole     UserRole  @default(owner)
  content        String
  isInternalOnly Boolean   @default(false)
  createdAt      DateTime  @default(now())

  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author         User?     @relation(fields: [authorId], references: [id])

  @@map("task_comments")
}

model TaskTimelineEvent {
  id          String            @id @default(uuid())
  taskId      String
  actorId     String?
  actorName   String
  actorRole   UserRole          @default(owner)
  type        TimelineEventType @default(status_change)
  title       String
  description String
  timestamp   DateTime          @default(now())

  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor       User?             @relation(fields: [actorId], references: [id])

  @@map("task_timeline_events")
}

model ComplianceNotification {
  id             String                @id @default(uuid())
  organizationId String
  userId         String
  taskId         String?
  milestone      NotificationMilestone
  title          String
  message        String
  linkUrl        String?
  isRead         Boolean               @default(false)
  readAt         DateTime?
  dueDateVersion DateTime?
  createdAt      DateTime              @default(now())

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?                 @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, milestone, userId])
  @@index([organizationId, userId, isRead])
  @@map("compliance_notifications")
}

model EvidenceDocument {
  id                String         @id @default(uuid())
  organizationId    String
  linkedTaskId      String?
  name              String
  category          String
  fileType          String
  fileSize          String
  filePath          String
  fileUrl           String?
  uploadedBy        String
  uploadedRole      UserRole       @default(owner)
  uploadedAt        DateTime       @default(now())
  version           String         @default("1.0")
  expiryDate        DateTime?
  status            EvidenceStatus @default(unverified)
  rejectionReason   String?
  ocrExtractedData  Json?          @default("{}")
  ocrVerified       Boolean        @default(false)
  viewPermissions   Json?          @default("[]")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task              Task?          @relation(fields: [linkedTaskId], references: [id])

  @@map("evidence_documents")
}

model Wallet {
  id             String              @id @default(uuid())
  organizationId String              @unique
  balance        Float               @default(0)
  heldAmount     Float               @default(0)
  currency       String              @default("VND")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String            @id @default(uuid())
  walletId    String
  code        String
  taskName    String?
  requestedBy String
  amount      Float
  type        TransactionType
  status      TransactionStatus @default(pending)
  note        String?
  timestamp   DateTime          @default(now())

  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model CalendarNote {
  id             String       @id @default(uuid())
  organizationId String
  date           String       // Định dạng YYYY-MM-DD
  title          String
  content        String?
  category       String?      @default("general") // general, tax, labor, legal, reminder
  authorId       String?
  authorName     String?
  isCompleted    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, date])
  @@map("calendar_notes")
}
